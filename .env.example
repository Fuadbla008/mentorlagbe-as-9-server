# Copy to .env and replace every REPLACE_ME value before deploying.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/mentorlagbe
MONGO_TRANSACTIONS=false

# Auth
BETTER_AUTH_SECRET=REPLACE_ME_USE_A_LONG_RANDOM_STRING
BETTER_AUTH_URL=http://localhost:5000
# Public URL of this API, used by Stripe's return redirect (defaults to BETTER_AUTH_URL)
API_URL=http://localhost:5000
JWT_SECRET=REPLACE_ME_USE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Frontend. In production set both to https://mentorlagbe-client.vercel.app;
# Stripe redirects through /api/payments/return to CLIENT_URL/payment/success.
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Stripe (publishable key is public and can also be read from /api/config)
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_or_sk_live
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_pk_test_or_pk_live
# Optional. Without it, webhooks are disabled and /api/payments/verify upgrades the plan.
STRIPE_WEBHOOK_SECRET=
STRIPE_TUTOR_PRICE_ID=
STRIPE_STUDENT_PRICE_ID=
STRIPE_TUTOR_AMOUNT=15
STRIPE_STUDENT_AMOUNT=10

# ImgBB
IMGBB_KEY=REPLACE_ME

# Seeding (local/demo only)
SEED_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
SEED_USER_PASSWORD=REPLACE_ME_USER_PASSWORD
